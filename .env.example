# ─── Database ───
DATABASE_URL=postgresql://terminal:dev_password_change_me@localhost:5432/terminal
POSTGRES_PASSWORD=dev_password_change_me

# ─── Redis ───
REDIS_URL=redis://localhost:6379

# ─── JWT ───
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ─── Data Provider API Keys ───
# Polygon.io — https://polygon.io/dashboard/api-keys
POLYGON_API_KEY=

# IEX Cloud — https://iexcloud.io/console/tokens
IEX_API_KEY=

# Alpha Vantage — https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# NewsAPI — https://newsapi.org/account
NEWS_API_KEY=

# FRED — https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ─── LLM (for sentiment analysis / earnings summaries) ───
# Anthropic Claude API key for NLP pipeline
ANTHROPIC_API_KEY=

# ─── Monitoring ───
GRAFANA_PASSWORD=admin

# ─── Application ───
NODE_ENV=development
LOG_LEVEL=debug
PORT=3000
